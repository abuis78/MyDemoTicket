# Example HEC token for MyDemoTicket (Settings > Data inputs > HTTP Event Collector
# does the same in the UI). The token value is generated by Splunk - never commit it.
# "indexes" must list every tenant index the app may write to; the event's "index"
# field selects one of them, "index" below is the default.

[http://mydemoticket]
disabled = 0
sourcetype = mydemoticket:audit
index = mdt_default
indexes = mdt_default,mdt_soc_games,mdt_usa_demo
useACK = 0

# Optional: index the local fallback log with a Universal Forwarder instead of HEC.
# [monitor:///var/lib/mydemoticket/logs/audit.log]
# sourcetype = mydemoticket:audit
# index = mdt_default
