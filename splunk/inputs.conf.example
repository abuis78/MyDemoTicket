# Example HEC token for MyDemoTicket (Settings > Data inputs > HTTP Event Collector
# does the same in the UI). The token value is generated by Splunk - never commit it.

[http://mydemoticket]
disabled = 0
sourcetype = mydemoticket:audit
index = mydemoticket
indexes = mydemoticket
useACK = 0

# The local fallback file <data_dir>/logs/audit.log can be indexed with a Universal
# Forwarder. NOTE: such events carry tenant only inside the JSON, not as indexed
# field, so tenant roles (srchFilter = tenant::<slug>) will NOT see them - only
# mdt_admin does. Use it for forensics / backfill, not as the primary path.
# [monitor:///var/lib/mydemoticket/logs/audit.log]
# sourcetype = mydemoticket:audit
# index = mydemoticket
